{
  "name": "context-forge",
  "version": "0.1.0",
  "description": "Engineering context and requirement intelligence for coding agents",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "context-forge": "dist/index.js",
    "context-forge-ingest": "dist/cli/ingest.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx src/index.ts",
    "ingest": "node --import tsx src/cli/ingest.ts",
    "seed": "node --import tsx src/cli/seed.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
